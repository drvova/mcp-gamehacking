{
  "name": "mcp-gamehacking",
  "version": "4.0.0",
  "description": "MCP server for game hacking & reverse engineering \u2014 4,100+ skills, 75 agents, 161 subagents, 114 plugins, 148 prompts, full-text grep, offset cross-ref, similarity search, offset export, function finder",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rs lib",
    "start": "node dist/index.js",
    "dev": "rs lib --watch",
    "test": "rs test",
    "test:gates": "node tools/checks/check.mjs all",
    "test:gate": "node tools/checks/check.mjs",
    "verify": "npm run build && npm run check && npm run test && npm run test:gates",
    "lint": "rs lint",
    "format": "rs fmt",
    "check": "rs check --type-check",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "game-hacking",
    "reverse-engineering",
    "cheat-development",
    "anti-cheat",
    "kernel-driver",
    "hypervisor",
    "esp",
    "aimbot",
    "injection",
    "hooking"
  ],
  "author": "whory",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/whory/mcp-gamehacking.git"
  },
  "homepage": "https://github.com/whory/mcp-gamehacking#readme",
  "bugs": {
    "url": "https://github.com/whory/mcp-gamehacking/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rstack": "^0.8.5",
    "typescript": "^5.7.0"
  }
}
